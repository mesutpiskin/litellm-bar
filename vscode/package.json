{
  "name": "litellm-usage",
  "displayName": "LiteLLM Usage",
  "description": "See your LiteLLM model, token and spend usage in the VS Code status bar",
  "version": "0.1.0",
  "publisher": "mesutpiskin",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/mesutpiskin/litellm-bar"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other", "Visualization"],
  "keywords": ["litellm", "llm", "tokens", "usage", "spend"],
  "main": "./out/extension.js",
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "commands": [
      { "command": "litellm.showDashboard", "title": "LiteLLM: Kullanım Paneli", "icon": "$(graph)" },
      { "command": "litellm.login", "title": "LiteLLM: Giriş Yap" },
      { "command": "litellm.logout", "title": "LiteLLM: Çıkış Yap" },
      { "command": "litellm.refresh", "title": "LiteLLM: Yenile" }
    ],
    "configuration": {
      "title": "LiteLLM Usage",
      "properties": {
        "litellm.baseUrl": {
          "type": "string",
          "default": "",
          "description": "LiteLLM proxy adresi, ör. https://litellm.sirket.com"
        },
        "litellm.refreshMinutes": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "description": "Otomatik yenileme aralığı (dakika)"
        },
        "litellm.statusBar": {
          "type": "string",
          "enum": ["todaySpend", "todayTokens", "totalSpend", "icon"],
          "enumDescriptions": ["Bugünkü harcama", "Bugünkü token", "Toplam harcama", "Sadece ikon"],
          "default": "todaySpend",
          "description": "Durum çubuğunda gösterilecek değer"
        },
        "litellm.allowInsecureTLS": {
          "type": "boolean",
          "default": false,
          "description": "Self-signed / kurumsal sertifikalara güven"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "package": "vsce package --no-dependencies",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "~1.85.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^5.5.0"
  }
}
