{
  "name": "litellm-usage",
  "displayName": "LiteLLM Usage",
  "description": "Track your LiteLLM proxy spend, token and model usage from the VS Code status bar — no admin account required.",
  "version": "0.3.0",
  "publisher": "mesutpiskin",
  "author": {
    "name": "Mesut Pişkin",
    "email": "mesutpiskin@outlook.com"
  },
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1e3a8a",
    "theme": "dark"
  },
  "homepage": "https://github.com/mesutpiskin/litellm-usage#readme",
  "bugs": {
    "url": "https://github.com/mesutpiskin/litellm-usage/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mesutpiskin/litellm-usage.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "litellm",
    "llm",
    "openai",
    "tokens",
    "usage",
    "spend",
    "budget",
    "cost"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "litellm.showDashboard",
        "title": "Show Usage Dashboard",
        "category": "LiteLLM",
        "icon": "$(graph)"
      },
      {
        "command": "litellm.login",
        "title": "Sign In",
        "category": "LiteLLM"
      },
      {
        "command": "litellm.logout",
        "title": "Sign Out",
        "category": "LiteLLM"
      },
      {
        "command": "litellm.refresh",
        "title": "Refresh",
        "category": "LiteLLM"
      }
    ],
    "configuration": {
      "title": "LiteLLM Usage",
      "properties": {
        "litellm.baseUrl": {
          "type": "string",
          "default": "",
          "markdownDescription": "Base URL of your LiteLLM proxy, e.g. `https://litellm.example.com`."
        },
        "litellm.refreshMinutes": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "description": "Auto-refresh interval in minutes."
        },
        "litellm.statusBar": {
          "type": "string",
          "enum": [
            "todaySpend",
            "todayTokens",
            "totalSpend",
            "icon"
          ],
          "enumDescriptions": [
            "Today's spend",
            "Today's tokens",
            "Total spend",
            "Icon only"
          ],
          "default": "todaySpend",
          "description": "What to show in the status bar."
        },
        "litellm.allowInsecureTLS": {
          "type": "boolean",
          "default": false,
          "description": "Accept self-signed or untrusted TLS certificates (e.g. internal proxies)."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "test": "npm run compile && node --test test/*.test.js",
    "package": "vsce package --no-dependencies",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "~1.85.0",
    "@vscode/vsce": "^3.0.0",
    "ovsx": "^0.10.0",
    "typescript": "^5.5.0"
  }
}
